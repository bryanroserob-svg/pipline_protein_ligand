; md_prod.mdp - Simulación de producción
; Compatible con CHARMM36 / CGenFF
; SIN RESTRICCIONES POSICIONALES

; PARÁMETROS DE INTEGRACIÓN
integrator               = md
dt                       = 0.002
nsteps                   = 5000000      ; 10 ns (el script lo ajusta según elección del usuario)
comm-mode                = Linear
nstcomm                  = 100

; SALIDA
nstxout                  = 0            ; No guardar coordenadas completas
nstvout                  = 0            ; No guardar velocidades
nstfout                  = 0            ; No guardar fuerzas
nstlog                   = 5000         ; Log cada 10 ps
nstenergy                = 5000         ; Energías cada 10 ps
nstxout-compressed       = 5000         ; Trayectoria comprimida cada 10 ps
compressed-x-grps        = System

; ENLACES
continuation             = yes
constraint_algorithm     = lincs
constraints              = h-bonds
lincs_iter               = 1
lincs_order              = 4

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.2
pme_order                = 4
fourierspacing           = 0.16

; VAN DER WAALS (CHARMM36: force-switch)
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no

; CONTROL DE TEMPERATURA
tcoupl                   = V-rescale
tc-grps                  = Protein_Ligand Solvent
tau_t                    = 1.0     1.0
ref_t                    = 300     300

; CONTROL DE PRESIÓN
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 5.0
ref_p                    = 1.0
compressibility          = 4.5e-5

; VELOCIDADES
gen_vel                  = no
