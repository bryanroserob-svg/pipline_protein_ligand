; md_prod.mdp - Simulación de producción (10 ns)
; SIN RESTRICCIONES POSICIONALES

; PARÁMETROS DE INTEGRACIÓN
integrator               = md
dt                       = 0.002
nsteps                   = 5000000      ; 10 ns (ajusta según necesites)
comm-mode                = Linear
nstcomm                  = 100

; SALIDA
nstxout                  = 0            ; No guardar coordenadas completas
nstvout                  = 0            ; No guardar velocidades
nstfout                  = 0            ; No guardar fuerzas
nstlog                   = 5000         ; Log cada 10 ps
nstenergy                = 5000         ; Energías cada 10 ps
nstxout-compressed       = 5000         ; Trayectoria comprimida cada 10 ps
compressed-x-grps        = System

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 10
ns_type                  = grid
pbc                      = xyz
rlist                    = 1.0

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.0
pme_order                = 4
fourierspacing           = 0.12

; VAN DER WAALS
rvdw                     = 1.0
DispCorr                 = EnerPres

; CONTROL DE TEMPERATURA
tcoupl                   = V-rescale
tc-grps                  = Protein_LIG Solvent
tau_t                    = 0.1     0.1
ref_t                    = 300     300

; CONTROL DE PRESIÓN
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

; VELOCIDADES
gen_vel                  = no

; RESTRICCIONES
constraints              = h-bonds
constraint_algorithm     = lincs
lincs_iter               = 1
lincs_order              = 4

; CONDICIONES PERIÓDICAS
pbc                      = xyz

; OPCIONES DE ENERGÍA
; FREE ENERGY CALCULATIONS (opcional, comentado)
; free-energy              = no
