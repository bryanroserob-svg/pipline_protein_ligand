; nvt.mdp - Equilibración NVT (calentamiento a 300K)
; Compatible con CHARMM36 / CGenFF
; IMPORTANTE: El script añadirá automáticamente: define = -DPOSRES -DPOSRES_LIG

; PARÁMETROS DE INTEGRACIÓN
integrator               = md
dt                       = 0.002
nsteps                   = 50000        ; 100 ps
comm-mode                = Linear
nstcomm                  = 100

; SALIDA
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 500
nstenergy                = 500
nstxout-compressed       = 500
compressed-x-grps        = System

; ENLACES
continuation             = no
constraint_algorithm     = lincs
constraints              = h-bonds
lincs_iter               = 1
lincs_order              = 4

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
rlist                    = 1.2

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.2
pme_order                = 4
fourierspacing           = 0.12

; VAN DER WAALS (CHARMM36: force-switch)
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no

; CONTROL DE TEMPERATURA (NVT)
tcoupl                   = V-rescale
tc-grps                  = Protein_Ligand Solvent
tau_t                    = 1.0     1.0
ref_t                    = 300     300

; CONTROL DE PRESIÓN
pcoupl                   = no

; VELOCIDADES
gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = __SEED_PLACEHOLDER__   ; inyectado por md_pipeline_mejorado.sh
