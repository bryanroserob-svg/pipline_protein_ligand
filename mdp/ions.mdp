; ions.mdp - Preparación para añadir iones
; Parámetros mínimos para generar el TPR necesario para genion

; PARÁMETROS DE INTEGRACIÓN
integrator               = steep
nsteps                   = 0

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 1
pbc                      = xyz
rlist                    = 1.2

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.2
pme_order                = 4
fourierspacing           = 0.12

; VAN DER WAALS
rvdw                     = 1.2
