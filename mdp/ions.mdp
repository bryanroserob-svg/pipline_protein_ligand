; ions.mdp - Preparación para añadir iones (CHARMM36 compatible)
; Parámetros mínimos para generar el TPR necesario para genion

; PARÁMETROS DE INTEGRACIÓN
integrator               = steep
nsteps                   = 0

; SALIDA (mínima, solo para TPR)
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 0
nstenergy                = 0

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 1
pbc                      = xyz
rlist                    = 1.2

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.2
pme_order                = 4
fourierspacing           = 0.12

; VAN DER WAALS (CHARMM36: force-switch)
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no

; RESTRICCIONES (ninguna para este paso)
constraints              = none
