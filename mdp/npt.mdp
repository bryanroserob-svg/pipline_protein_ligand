; npt.mdp - Equilibración NPT (presión a 1 bar)
; Compatible con CHARMM36 / CGenFF
; IMPORTANTE: El script añadirá automáticamente: define = -DPOSRES -DPOSRES_LIG

; PARÁMETROS DE INTEGRACIÓN
integrator               = md
dt                       = 0.002
nsteps                   = 500000       ; 1 ns
comm-mode                = Linear
nstcomm                  = 100

; SALIDA
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 500
nstenergy                = 500
nstxout-compressed       = 500
compressed-x-grps        = System

; ENLACES
continuation             = yes
constraint_algorithm     = lincs
constraints              = h-bonds
lincs_iter               = 1
lincs_order              = 4

; VECINOS
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
rlist                    = 1.2

; ELECTROSTÁTICA
coulombtype              = PME
rcoulomb                 = 1.2
pme_order                = 4
fourierspacing           = 0.16

; VAN DER WAALS (CHARMM36: force-switch)
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no

; CONTROL DE TEMPERATURA
tcoupl                   = V-rescale
tc-grps                  = Protein_Ligand Solvent
tau_t                    = 1.0     1.0
ref_t                    = 300     300

; CONTROL DE PRESIÓN (NPT)
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 5.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

; VELOCIDADES
gen_vel                  = no
